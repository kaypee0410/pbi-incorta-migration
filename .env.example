# Copy this file to .env and fill in what you need. .env is ignored by git.

# Web server (keep 127.0.0.1 so only this computer can reach it)
PBI_HOST=127.0.0.1
PBI_PORT=5001
PBI_MAX_UPLOAD_MB=1024
PBI_WORKERS=2

# 1 = keep uploaded files in uploads/ after processing (default 0 deletes them)
PBI_KEEP_UPLOADS=0
